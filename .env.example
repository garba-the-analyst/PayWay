# PayWay — card collections settled as USDT
# Copy to .env for local dev. Production secrets live in Render env (see render.yaml).
DATABASE_URL=postgresql://payway:payway_dev@localhost:5432/payway
REDIS_URL=redis://localhost:6379
PORT=3000

DEFAULT_CURRENCY=USD
# Card collectors (we are the merchant — one KYB, payers frictionless)
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_paystack_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
FLUTTERWAVE_WEBHOOK_SECRET=flw_wh_xxx
# Ops gate: when set and not containing 'xxx', /api/v1/pay list + settle require x-admin-token.
ADMIN_TOKEN=change-me-to-a-long-random-string
# USDT conversion: live rate via CoinGecko; RATE_SOURCE_STUB=true forces 1.0 (dev/tests).
RATE_SOURCE_STUB=
# Our USDT receiving wallet (TRON) — displayed to ops; spending happens in treasury.
SETTLEMENT_WALLET_USDT=


