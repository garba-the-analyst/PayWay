NEXT_PUBLIC_PAYWAY_API=http://localhost:3000
NEXT_PUBLIC_MERCHANT_ID=demo_merchant
# Paystack public key: enables the embedded card window on the pay page.
# NEVER put secret keys here. Without it, checkout falls back to a hosted page.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Ops console lives at /vault/<ADMIN_SLUG> (unlinked). Pick a long random slug.
NEXT_PUBLIC_ADMIN_SLUG=vault-9f3k7q2m
# Must match the API's ADMIN_TOKEN for the orders list to load.
NEXT_PUBLIC_ADMIN_TOKEN=change-me-to-a-long-random-string
